# ── Base de datos ─────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host:5432/soul_surf_db"

# ── Servidor ──────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
FRONTEND_URL=https://soulsurfschool.mx
BACKEND_URL=https://api.soulsurfschool.mx

# ── Auth ──────────────────────────────────────────────────────
JWT_SECRET=cambia_esto_por_un_secreto_seguro_de_32_chars_minimo
JWT_EXPIRES_IN=8h

# ── MercadoPago ───────────────────────────────────────────────
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxx
MP_PUBLIC_KEY=APP_USR-xxxxxxxxxxxx
MP_WEBHOOK_SECRET=

# ── Cloudflare R2 ─────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=soul-surf-media
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# ── Datos bancarios SPEI ──────────────────────────────────────
SPEI_CLABE=
SPEI_BANK=BBVA
SPEI_ACCOUNT_HOLDER=Soul Surf School SA de CV
SPEI_CONCEPT=Reserva Soul Surf School

# ── Resend (emails) ───────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM=Soul Surf School <reservas@soulsurfschool.mx>

# ── WhatsApp Meta Cloud API ───────────────────────────────────
WA_TOKEN=
WA_PHONE_ID=

# ── Admin inicial (solo para db:seed) ─────────────────────────
ADMIN_SEED_PASSWORD=CambiaEstoEnProduccion!
